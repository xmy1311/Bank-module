            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Pedro Ruiz Duplicado\",\n  \"genero\": \"Masculino\",\n  \"edad\": 40,\n  \"identificacion\": \"{{identificacionNueva}}\",\n  \"direccion\": \"Otra dirección\",\n  \"telefono\": \"0987654321\",\n  \"contrasena\": \"clave456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
