          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
                  "pm.test('code = CLIENTE_DUPLICADO', () => pm.expect(pm.response.json().code).to.eql('CLIENTE_DUPLICADO'));",
                  "pm.test('Content-Type RFC 7807', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json'));"
                ]
              }
            }
          ]
        },
