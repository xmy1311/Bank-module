  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Identificación y número de cuenta únicos por ejecución: la colección se",
          "// puede correr muchas veces sin chocar con las claves únicas.",
          "if (!pm.collectionVariables.get('identificacionNueva')) {",
          "  const n = Date.now().toString().slice(-10);",
          "  pm.collectionVariables.set('identificacionNueva', n);",
          "  pm.collectionVariables.set('numeroCuentaNueva', '7' + n.slice(-5));",
          "}",
          "",
          "// Pausa antes de crear la cuenta: da tiempo a que el evento del cliente",
          "// llegue al Account Service (consistencia eventual, ver descripción).",
          "if (pm.info.requestName.indexOf('Crear cuenta para el cliente nuevo') === 0) {",
          "  const hasta = Date.now() + 1500;",
          "  while (Date.now() < hasta) { /* espera activa: Postman no tiene sleep */ }",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Responde en menos de 2 s', () => pm.expect(pm.response.responseTime).to.be.below(2000));"
        ]
      }
    }
