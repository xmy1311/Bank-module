# ==============================================================================
# Plantilla de variables de entorno.
#
#   cp .env.example .env
#   docker compose up --build
#
# .env está en .gitignore: NUNCA se versiona. Este archivo sí, con placeholders.
# ==============================================================================

# ── SQL Server ────────────────────────────────────────────────────────────────
# Debe cumplir la política de SQL Server: >= 8 caracteres con mayúsculas,
# minúsculas, dígitos y símbolos. Si no, el contenedor arranca y muere sin
# mensaje claro.
MSSQL_SA_PASSWORD=Devsu#Local2026!

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_DEFAULT_USER=devsu
RABBITMQ_DEFAULT_PASS=Devsu#Local2026!

# ── Puertos publicados en el HOST ─────────────────────────────────────────────
# Dentro de la red de Docker los puertos NO cambian (1433, 5672, 15672, 8080);
# estos valores solo afectan a cómo se accede desde tu máquina.
#
# Si alguno está ocupado, el arranque falla con:
#   "Bind for 0.0.0.0:1433 failed: port is already allocated"
# Compruébalo con:  docker ps --format "{{.Names}}\t{{.Ports}}"
# y cambia aquí el valor (p. ej. 14340, 5673, 15673).
MSSQL_PORT=1433
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
CUSTOMER_API_PORT=5001
ACCOUNT_API_PORT=5002

# ── ASP.NET Core ──────────────────────────────────────────────────────────────
# En Production el manejador global de errores NO expone el detalle interno de
# las excepciones: solo el mensaje genérico. El detalle va al log.
ASPNETCORE_ENVIRONMENT=Production
